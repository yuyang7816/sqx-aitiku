	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": ["auth", "setup", "question", "practice", "member", "common"]
		},
		"pages/practice/practice": {
			"network": "all",
			"packages": ["question", "practice"]
		},
		"pages/my/my": {
			"network": "all",
			"packages": ["member", "profile", "promo"]
		},
		"pages/ai/ai": {
			"network": "all",
			"packages": ["ai", "question"]
		},
		"pages/notebook/notebook": {
